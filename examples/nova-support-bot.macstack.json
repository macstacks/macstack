  },
  "lifecycle": {
    "stage": "test",
    "coverage_target": "70% → 95%",
    "needs_from_client": [
      "An export of FAQs and internal policies for the KB",
      "Escalation rules (who is on duty)"
    ],
    "next_steps": [
      "Push deflection up to 150/mo",
      "A/B test the support agent's prompt",
      "Voice messages (later)"
    ],
    "updated": "2026-08-09"
  },
  "commercial": {
    "offer": {
      "type": "Agents Stack",
      "price_range": "$3,000–$10,000",
      "model": "one_time"
    },
    "cost_of_ownership": {
      "items": [
        {
          "name": "Server (PG + Qdrant + n8n + Trigger)",
          "usd_month": 25
        },
        {
          "name": "Claude API (support agent, haiku)",
          "usd_month": "15–50"
